android_app_import {
    name: "ViPER4AndroidFX",
    owner: "ViperFX",
    apk: "system/priv-app/ViPER4AndroidFX/ViPER4AndroidFX.apk",
    privileged: true,
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
    overrides: ["AudioFX", "MusicFX"],
    required: [
        "privapp-permissions-viper4android.xml",
        "libv4a_re",
    ],
}

cc_prebuilt_library_shared {
    name: "libv4a_re",
    strip: {
        none: true,
    },
    target: {
        android_arm: {
            srcs: [
                "vendor/lib/soundfx/libv4a_re.so",
            ],
        },
        android_arm64: {
            srcs: [
                "vendor/lib64/soundfx/libv4a_re.so",
            ],
        },
    },
    shared_libs: [
        "libaudioutils",
        "libcutils",
        "liblog",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    ignore_max_page_size: true,
    compile_multilib: "both",
    relative_install_path: "soundfx",
    prefer: true,
    soc_specific: true,
}

prebuilt_etc {
    name: "privapp-permissions-viper4android.xml",
    src: "permissions/privapp-permissions-viper4android.xml",
    sub_dir: "permissions",
}
